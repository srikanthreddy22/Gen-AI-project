# Copy to .env and set your local credentials.
FLASK_APP=run.py
FLASK_DEBUG=0
PORT=5000

# MySQL / SQLAlchemy
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/notebot
NOTEBOT_AUTO_CREATE_SCHEMA=false
SQLALCHEMY_TRACK_MODIFICATIONS=false

# Flask session and JWT signing (replace both with independent random secrets)
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Upload and persistent vector storage
UPLOAD_FOLDER=./data/uploads
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Gemini 2.5 Flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# Sentence Transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2

# Retrieval augmented generation
RAG_TOP_K=8
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_DEBUG=0

# Admin and optional legacy-index migration
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:5173
NOTEBOT_DISABLE_LEGACY_VECTOR_MIGRATION=0
LEGACY_VECTOR_STORE_PATH=./.vector_store.db
